---
import { route, zones, house, cameras, HOUSE_CENTER } from '../data';

const routeD = 'M' + route.map(([x, y]) => `${x} ${y}`).join(' L');
const trees = [
  [150, 150, 22], [235, 262, 28], [310, 120, 20], [405, 205, 26], [700, 225, 18],
  [820, 150, 26], [905, 300, 22], [780, 520, 24], [130, 385, 24], [875, 465, 20],
];
// Five arches along the front of the house (the gallery).
const arches = Array.from({ length: 5 }, (_, i) => {
  const x = house.x + 12 + i * 34;
  return `M${x} ${house.y + house.h + 28} a14 14 0 0 1 28 0`;
}).join(' ');
const data = JSON.stringify({ route, cameras, house: HOUSE_CENTER });
---

<svg
  class="plan"
  viewBox="0 0 1000 640"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Esquema ilustrativo del terreno de Mendoza 1042 con el recorrido por la casa: portón, galería, recibidor, living, comedor, cocina, sala vidriada y pileta."
  data-plan={data}
>
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" class="grid-line" />
    </pattern>
    <pattern id="hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V9" class="hatch-line" />
    </pattern>
    <pattern id="boards" width="12" height="12" patternUnits="userSpaceOnUse">
      <path d="M0 0H12" class="hatch-line" />
    </pattern>
  </defs>

  <rect x="-3000" y="-3000" width="7000" height="7000" fill="url(#grid)" />

  <!-- Street -->
  <rect class="street" x="-3000" y="590" width="7000" height="3000" />
  <path class="centerline" d="M-3000 645H4000" />

  <!-- Lot -->
  <rect class="lot-fill" x="60" y="50" width="880" height="540" />
  <path class="lot-line" d="M230 590H60V50H940V590H290" />
  <path class="gate" d="M230 590L262 556" />
  <g class="trees">
    {trees.map(([x, y, r]) => (
      <>
        <circle cx={x} cy={y} r={r} />
        <circle cx={x} cy={y} r="2" class="tree-dot" />
      </>
    ))}
  </g>
  <rect class="carport" x="112" y="498" width="100" height="78" />

  <!-- House, gallery, deck and pool -->
  <rect class="house-fill" x={house.x} y={house.y} width={house.w} height={house.h} />
  <rect class="house-hatch" x={house.x} y={house.y} width={house.w} height={house.h} />
  <rect class="house-line" x={house.x} y={house.y} width={house.w} height={house.h} />
  <rect class="gallery" x={house.x} y={house.y + house.h} width={house.w} height="28" />
  <path class="arches" d={arches} />
  <rect class="deck" x="640" y="350" width="200" height="112" />
  <rect class="deck-boards" x="640" y="350" width="200" height="112" />
  <rect class="pool" x="668" y="374" width="128" height="48" rx="3" />

  <!-- Route -->
  <path class="route-ghost" d={routeD}></path>
  <path class="route-done" d={routeD}></path>

  <!-- Labels and markers live in screen-pixel space (scaled by JS) so they stay legible at any zoom -->
  <g class="px" data-at="100,104" data-overview>
    <text class="lbl lbl-strong" y="0">TERRENO</text>
    <text class="lbl" y="19">3.058,71 m²</text>
  </g>
  <g class="px" data-at={`${house.x + house.w / 2},${house.y - 14}`} data-overview>
    <text class="lbl lbl-strong" text-anchor="middle" y="0">CASA</text>
    <text class="lbl" text-anchor="middle" y="-19">151,94 m²</text>
  </g>
  <g class="px" data-at="560,626" data-overview>
    <text class="lbl lbl-dim">CALLE MENDOZA</text>
  </g>
  <g class="px wide-only" data-at="112,490" data-overview>
    <text class="lbl lbl-dim">Cochera</text>
  </g>

  {zones.map((z, i) => (
    <g class="px zone" data-zone={i + 1} data-at={route[z.wp].join(',')}>
      <circle r="13" class="zone-dot" />
      <text class="zone-n" text-anchor="middle" y="4.5">{i + 1}</text>
      <text class="zone-name" x="21" y="-14">{z.name}</text>
    </g>
  ))}

  <g class="px walker" data-at={route[0].join(',')}>
    <circle r="7" />
  </g>
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>('svg.plan')!;
  const stage = svg.closest<HTMLElement>('[data-stage]')!;
  const box = () => svg.getBoundingClientRect();
  const plan = JSON.parse(svg.dataset.plan!) as {
    route: [number, number][];
    cameras: { cx: number; cy: number; w: number }[];
    house: [number, number];
  };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const px = [...svg.querySelectorAll<SVGGElement>('.px')];
  const zoneEls = px.filter((g) => g.classList.contains('zone'));
  const walker = svg.querySelector<SVGGElement>('.walker')!;
  const done = svg.querySelector<SVGPathElement>('.route-done')!;
  const total = done.getTotalLength();
  done.style.strokeDasharray = `${total}`;

  // Distance along the route at each waypoint.
  const cum: number[] = [0];
  for (let i = 1; i < plan.route.length; i++) {
    const [ax, ay] = plan.route[i - 1];
    const [bx, by] = plan.route[i];
    cum.push(cum[i - 1] + Math.hypot(bx - ax, by - ay));
  }
  const zoneWp = zoneEls.map((g) => {
    const [x, y] = g.dataset.at!.split(',').map(Number);
    return plan.route.findIndex(([rx, ry]) => rx === x && ry === y);
  });

  let aspect = 1.5;
  type State = { cx: number; cy: number; w: number; d: number };
  const camFor = (i: number): State => {
    if (i === 0) return { cx: 500, cy: 265, w: Math.max(1060, 720 * aspect), d: 0 };
    const c = plan.cameras[i - 1];
    return { ...c, d: cum[zoneWp[i - 1]] };
  };
  let step = 0;
  let cur: State = camFor(0);
  let raf = 0;

  function render() {
    const r = box();
    if (!r.width || !r.height) return;
    aspect = r.width / r.height;
    const h = cur.w / aspect;
    svg.setAttribute('viewBox', `${cur.cx - cur.w / 2} ${cur.cy - h / 2} ${cur.w} ${h}`);
    const k = cur.w / r.width; // user units per screen pixel
    // Zone markers shrink to dots while the whole lot is in view, and grow as the camera closes in.
    const near = Math.min(1, Math.max(0, (900 - cur.w) / 500));
    const f = 0.34 + 0.66 * near;
    const small = r.width < 600 ? 0.8 : 1; // phone stage: labels a touch smaller
    for (const g of px) {
      const [x, y] = g.dataset.at!.split(',').map(Number);
      const s = (g.classList.contains('zone') ? k * f : k) * small;
      g.setAttribute('transform', `translate(${x} ${y}) scale(${s})`);
      if (g.classList.contains('zone')) g.style.setProperty('--near', near > 0.6 ? '1' : '0');
    }
    const p = done.getPointAtLength(Math.min(Math.max(cur.d, 0), total));
    walker.setAttribute('transform', `translate(${p.x} ${p.y}) scale(${k})`);
    done.style.strokeDashoffset = `${total - cur.d}`;
  }

  function go(i: number) {
    step = i;
    stage.dataset.step = String(i);
    zoneEls.forEach((g, n) => {
      g.classList.toggle('is-active', n + 1 === i);
      g.classList.toggle('is-visited', n + 1 < i);
    });
    const target = camFor(i);
    cancelAnimationFrame(raf);
    if (reduced.matches) {
      cur = target;
      render();
      return;
    }
    const from = { ...cur };
    const t0 = performance.now();
    const dur = 1200;
    const tick = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      const e = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
      cur = {
        cx: from.cx + (target.cx - from.cx) * e,
        cy: from.cy + (target.cy - from.cy) * e,
        w: from.w + (target.w - from.w) * e,
        d: from.d + (target.d - from.d) * e,
      };
      render();
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  }

  new ResizeObserver(() => {
    const r = box();
    if (r.width && r.height) aspect = r.width / r.height;
    if (step === 0) cur = camFor(0);
    render();
  }).observe(svg);

  // The step crossing the reading line drives the camera.
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const mq = matchMedia('(min-width: 900px)');
  let io: IntersectionObserver | undefined;
  function observe() {
    io?.disconnect();
    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const i = Number((e.target as HTMLElement).dataset.step);
          steps.forEach((s) => s.classList.toggle('is-active', s === e.target));
          if (i !== step) go(i);
        }
      },
      { rootMargin: mq.matches ? '-49% 0px -49% 0px' : '-45% 0px -53% 0px' },
    );
    steps.forEach((s) => io!.observe(s));
  }
  mq.addEventListener('change', observe);
  observe();
  steps[0]?.classList.add('is-active');
  render();
</script>
